# Stripe (required to enable checkout)
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Used to build absolute Stripe redirect URLs when not inferrable from the request.
# Set this to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
